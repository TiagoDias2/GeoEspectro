@page
@model ExternalLoginModel
@{
    ViewData["Title"] = "Registar";
}

<h1>@ViewData["Title"]</h1>
<h2 id="external-login-title">Associar a sua conta @Model.ProviderDisplayName.</h2>
<hr />

<p id="external-login-description" class="text-info">
    Autenticação com <strong>@Model.ProviderDisplayName</strong> efetuada com sucesso.
    Por favor, introduza um endereço de email para este site e clique no botão "Registar" para concluir o processo de login.
</p>

<div class="row">
    <div class="col-md-4">
        <form asp-page-handler="Confirmation" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="email" placeholder="Introduza o seu email." />
                <label asp-for="Input.Email" class="form-label"></label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Registar</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
