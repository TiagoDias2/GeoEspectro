@using GeoEspectro.Data
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
}

<ul class="list-group list-group-flush">
    <li class="list-group-item px-3">
        <a class="nav-link p-0 @ManageNavPages.IndexNavClass(ViewContext)" asp-page="./Index">
            <i class="bi bi-person me-2"></i> Perfil
        </a>
    </li>
    <li class="list-group-item px-3">
        <a class="nav-link p-0 @ManageNavPages.EmailNavClass(ViewContext)" asp-page="./Email">
            <i class="bi bi-envelope me-2"></i> Email
        </a>
    </li>
    <li class="list-group-item px-3">
        <a class="nav-link p-0 @ManageNavPages.ChangePasswordNavClass(ViewContext)" asp-page="./ChangePassword">
            <i class="bi bi-key me-2"></i> Palavra-passe
        </a>
    </li>
    @if (hasExternalLogins)
    {
        <li class="list-group-item px-3">
            <a class="nav-link p-0 @ManageNavPages.ExternalLoginsNavClass(ViewContext)" asp-page="./ExternalLogins">
                <i class="bi bi-box-arrow-in-right me-2"></i> Logins externos
            </a>
        </li>
    }
    <li class="list-group-item px-3">
        <a class="nav-link p-0 @ManageNavPages.TwoFactorAuthenticationNavClass(ViewContext)" asp-page="./TwoFactorAuthentication">
            <i class="bi bi-shield-lock me-2"></i> Autenticação 2FA
        </a>
    </li>
    <li class="list-group-item px-3">
        <a class="nav-link p-0 @ManageNavPages.PersonalDataNavClass(ViewContext)" asp-page="./PersonalData">
            <i class="bi bi-person-vcard me-2"></i> Dados pessoais
        </a>
    </li>
</ul>
