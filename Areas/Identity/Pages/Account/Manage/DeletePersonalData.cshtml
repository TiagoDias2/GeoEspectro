@page
@model DeletePersonalDataModel
@{
    ViewData["Title"] = "Eliminar Dados Pessoais";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h3 class="mb-4 text-danger">@ViewData["Title"]</h3>

<div class="alert alert-warning" role="alert">
    <p>
        <strong>Esta ação irá eliminar permanentemente a sua conta e todos os dados associados. Esta operação é irreversível.</strong>
    </p>
</div>

<div class="row">
    <div class="col-md-6">
        <form id="delete-user" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            @if (Model.RequirePassword)
            {
                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" placeholder="Introduza a sua palavra-passe" />
                    <label asp-for="Input.Password">Palavra-passe</label>
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>
            }

            <button class="btn btn-danger btn-lg w-100" type="submit">
                Eliminar dados e fechar conta
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
