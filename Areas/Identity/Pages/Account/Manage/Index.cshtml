@page
@model GeoEspectro.Areas.Identity.Pages.Account.Manage.IndexModel
@{
    ViewData["Title"] = "Manage your account";
    ViewData["ActivePage"] = "Index";
}

<h3>@ViewData["Title"]</h3>

<partial name="_StatusMessage" for="StatusMessage" />

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div class="form-floating mb-3">
                <input asp-for="Input.Nome" class="form-control" />
                <label asp-for="Input.Nome" class="form-label"></label>
                <span asp-validation-for="Input.Nome" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Morada" class="form-control" />
                <label asp-for="Input.Morada" class="form-label"></label>
                <span asp-validation-for="Input.Morada" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.CodPostal" class="form-control" />
                <label asp-for="Input.CodPostal" class="form-label"></label>
                <span asp-validation-for="Input.CodPostal" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Pais" class="form-control" />
                <label asp-for="Input.Pais" class="form-label"></label>
                <span asp-validation-for="Input.Pais" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Nif" class="form-control" />
                <label asp-for="Input.Nif" class="form-label"></label>
                <span asp-validation-for="Input.Nif" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Telemovel" class="form-control" />
                <label asp-for="Input.Telemovel" class="form-label"></label>
                <span asp-validation-for="Input.Telemovel" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Guardar</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
