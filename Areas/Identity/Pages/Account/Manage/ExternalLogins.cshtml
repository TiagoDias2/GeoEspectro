@page
@model ExternalLoginsModel
@{
    ViewData["Title"] = "Gerir logins externos";
    ViewData["ActivePage"] = ManageNavPages.ExternalLogins;
}

<partial name="_StatusMessage" for="StatusMessage" />

@if (Model.CurrentLogins?.Count > 0)
{
    <h3 class="mb-3">Logins registados</h3>
    <table class="table">
        <tbody>
            @foreach (var login in Model.CurrentLogins)
            {
                <tr>
                    <td id="@($"login-provider-{login.LoginProvider}")">@login.ProviderDisplayName</td>
                    <td>
                        @if (Model.ShowRemoveButton)
                        {
                            <form id="@($"remove-login-{login.LoginProvider}")" asp-page-handler="RemoveLogin" method="post" class="d-inline">
                                <input asp-for="@login.LoginProvider" name="LoginProvider" type="hidden" />
                                <input asp-for="@login.ProviderKey" name="ProviderKey" type="hidden" />
                                <button type="submit" class="btn btn-danger btn-sm" title="Remover o login @login.ProviderDisplayName da sua conta">Remover</button>
                            </form>
                        }
                        else
                        {
                            @: &nbsp;
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">Nenhum login externo está atualmente associado à sua conta.</p>
}

@if (Model.OtherLogins?.Count > 0)
{
    <h4>Associar outro serviço à sua conta</h4>
    <hr />
    <form id="link-login-form" asp-page-handler="LinkLogin" method="post" class="form-horizontal">
        <div id="socialLoginList" class="d-flex flex-wrap gap-2">
            @foreach (var provider in Model.OtherLogins)
            {
                <button id="@($"link-login-button-{provider.Name}")"
                        type="submit"
                        class="btn btn-outline-primary"
                        name="provider"
                        value="@provider.Name"
                        title="Iniciar sessão com @provider.DisplayName">
                    @provider.DisplayName
                </button>
            }
        </div>
    </form>
}
else
{
    <p class="text-muted">Não há mais serviços disponíveis para associar à sua conta.</p>
}
