@page
@model Disable2faModel
@{
    ViewData["Title"] = "Desativar Autenticação de Dois Fatores (2FA)";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />

<h3 class="mb-4 text-danger">@ViewData["Title"]</h3>

<div class="alert alert-warning" role="alert">
    <p>
        <strong>Esta ação irá apenas desativar a autenticação de dois fatores (2FA).</strong>
    </p>
    <p>
        Desativar a 2FA não altera as chaves usadas nas aplicações autenticadoras.
        Se deseja alterar a chave usada numa aplicação autenticadora, deverá
        <a asp-page="./ResetAuthenticator" class="alert-link">redefinir as suas chaves de autenticação.</a>
    </p>
</div>

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <button class="btn btn-danger btn-lg w-100" type="submit">Desativar 2FA</button>
        </form>
    </div>
</div>
