@page
@model EnableAuthenticatorModel
@{
    ViewData["Title"] = "Configurar aplicação de autenticação";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />

<h3 class="mb-4">@ViewData["Title"]</h3>

<div>
    <p>Para utilizar uma aplicação de autenticação, siga os seguintes passos:</p>
    <ol class="list">
        <li>
            <p>
                Descarregue uma aplicação de autenticação como o Microsoft Authenticator para
                <a href="https://go.microsoft.com/fwlink/?Linkid=825072" target="_blank">Android</a> ou
                <a href="https://go.microsoft.com/fwlink/?Linkid=825073" target="_blank">iOS</a>,
                ou o Google Authenticator para
                <a href="https://play.google.com/store/apps/details?id=com.google.android.apps.authenticator2" target="_blank">Android</a> ou
                <a href="https://apps.apple.com/app/google-authenticator/id388497605" target="_blank">iOS</a>.
            </p>
        </li>
        <li>
            <p>
                Digitalize o código QR ou insira esta chave manualmente na aplicação:
                <kbd class="bg-light px-2">@Model.SharedKey</kbd><br />
                (Os espaços e maiúsculas/minúsculas não interferem)
            </p>

            <div class="alert alert-info">
                Se precisar de ajuda para ativar o código QR, veja
                <a href="https://go.microsoft.com/fwlink/?Linkid=852423" target="_blank">como ativar a geração de QR code</a>.
            </div>

            <div id="qrCode"></div>
            <div id="qrCodeData" data-url="@Model.AuthenticatorUri"></div>
        </li>
        <li>
            <p>
                Depois de configurar a aplicação, ela fornecerá um código único. Introduza esse código abaixo para confirmar.
            </p>

            <div class="row">
                <div class="col-md-6">
                    <form id="send-code" method="post">
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Code" class="form-control" autocomplete="off" placeholder="Introduza o código gerado" />
                            <label asp-for="Input.Code" class="form-label">Código de verificação</label>
                            <span asp-validation-for="Input.Code" class="text-danger"></span>
                        </div>
                        <button type="submit" class="w-100 btn btn-lg btn-primary">Verificar</button>
                        <div asp-validation-summary="ModelOnly" class="text-danger mt-2" role="alert"></div>
                    </form>
                </div>
            </div>
        </li>
    </ol>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
