@page
@model LoginWith2faModel
@{
    ViewData["Title"] = "Autenticação com dois fatores";
}

<h1 class="mb-4">@ViewData["Title"]</h1>
<hr />
<p>A tua conta está protegida com uma aplicação de autenticação. Introduz o código abaixo para continuares.</p>

<div class="row">
    <div class="col-md-4">
        <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
            <input asp-for="RememberMe" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <div class="form-floating mb-3">
                <input asp-for="Input.TwoFactorCode" class="form-control" autocomplete="off" placeholder="Código de autenticação" />
                <label asp-for="Input.TwoFactorCode" class="form-label">Código de autenticação</label>
                <span asp-validation-for="Input.TwoFactorCode" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="Input.RememberMachine" class="form-check-input" />
                <label asp-for="Input.RememberMachine" class="form-check-label">
                    @Html.DisplayNameFor(m => m.Input.RememberMachine)
                </label>
            </div>

            <button type="submit" class="w-100 btn btn-lg btn-primary">Iniciar sessão</button>
        </form>
    </div>
</div>

<p class="mt-3">
    Não tens acesso à aplicação de autenticação?
    <a id="recovery-code-login" asp-page="./LoginWithRecoveryCode" asp-route-returnUrl="@Model.ReturnUrl">Usa um código de recuperação</a>.
</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
