@page
@model LoginModel

@{
    ViewData["Title"] = "Iniciar sessão";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-4">
        <section>
            <form id="account" method="post">
                <h4>Utilize uma conta local para iniciar sessão</h4>
                <hr />
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="nome@exemplo.com" />
                    <label asp-for="Input.Email">Email</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" class="form-control" type="password" autocomplete="current-password" placeholder="Palavra-passe" />
                    <label asp-for="Input.Password">Palavra-passe</label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <div class="form-check mb-3">
                    <input class="form-check-input" asp-for="Input.RememberMe" />
                    <label class="form-check-label" asp-for="Input.RememberMe">
                        @Html.DisplayNameFor(m => m.Input.RememberMe)
                    </label>
                </div>

                <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary">Entrar</button>

                <div class="mt-3">
                    <p><a asp-page="./ForgotPassword">Esqueceste-te da palavra-passe?</a></p>
                    <p><a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Registar novo utilizador</a></p>
                    <p><a asp-page="./ResendEmailConfirmation">Reenviar confirmação de email</a></p>
                </div>
            </form>
        </section>
    </div>

    <div class="col-md-6 offset-md-1">
        <section>
            <h4>Ou usa um serviço externo</h4>
            <hr />
            @{
                if ((Model.ExternalLogins?.Count ?? 0) == 0)
                {
                    <div class="alert alert-info">
                        Não há serviços de autenticação externa configurados.
                        <a href="https://go.microsoft.com/fwlink/?LinkID=532715" target="_blank">Ver como configurar</a>.
                    </div>
                }
                else
                {
                    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                        @foreach (var provider in Model.ExternalLogins!)
                        {
                            <button type="submit" class="btn btn-outline-primary me-2 mb-2" name="provider" value="@provider.Name">
                                Iniciar sessão com @provider.DisplayName
                            </button>
                        }
                    </form>
                }
            }
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
