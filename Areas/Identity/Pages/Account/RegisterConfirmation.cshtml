@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Confirmação de registo";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="alert alert-info">
    @if (Model.DisplayConfirmAccountLink)
    {
        <p>
            Esta aplicação ainda não tem um serviço real de envio de emails configurado.<br />
            Veja <a href="https://aka.ms/aspaccountconf" target="_blank">estas instruções</a> para adicionar um remetente real.
        </p>
        <p class="mt-3">
            <strong>Link de confirmação temporário:</strong><br />
            <a id="confirm-link" href="@Model.EmailConfirmationUrl">@Model.EmailConfirmationUrl</a>
        </p>
    }
    else
    {
        <p>Foi enviado um email de confirmação para o endereço fornecido.</p>
        <p>Por favor, verifique a sua caixa de entrada (e também a pasta de spam).</p>
    }
</div>

<p class="mt-4">
    <a class="btn btn-primary" href="/">Voltar à página inicial</a>
</p>
