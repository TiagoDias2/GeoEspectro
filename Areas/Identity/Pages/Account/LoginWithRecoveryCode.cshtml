@page
@model LoginWithRecoveryCodeModel
@{
    ViewData["Title"] = "Código de recuperação";
}

<h1 class="mb-4">@ViewData["Title"]</h1>
<hr />
<p>
    Pediste para iniciar sessão com um código de recuperação. Esta sessão <strong>não será lembrada</strong>
    até usares um código da aplicação de autenticação ou desativares o 2FA e iniciares sessão novamente.
</p>

<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <div class="form-floating mb-3">
                <input asp-for="Input.RecoveryCode" class="form-control" autocomplete="off" placeholder="Código de recuperação" />
                <label asp-for="Input.RecoveryCode" class="form-label">Código de recuperação</label>
                <span asp-validation-for="Input.RecoveryCode" class="text-danger"></span>
            </div>

            <button type="submit" class="w-100 btn btn-lg btn-primary">Iniciar sessão</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
