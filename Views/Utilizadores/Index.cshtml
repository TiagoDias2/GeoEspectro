@model IEnumerable<GeoEspectro.Models.Utilizadores>

@{
    ViewData["Title"] = "Utilizadores";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">@ViewData["Title"]</h2>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-person-plus-fill"></i> Novo Utilizador
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-bordered mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.First().Nome)</th>
                            <th>@Html.DisplayNameFor(model => model.First().Morada)</th>
                            <th>@Html.DisplayNameFor(model => model.First().CodPostal)</th>
                            <th>@Html.DisplayNameFor(model => model.First().Pais)</th>
                            <th>@Html.DisplayNameFor(model => model.First().Nif)</th>
                            <th>@Html.DisplayNameFor(model => model.First().Telemovel)</th>
                            <th class="text-center">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Nome</td>
                                <td>@item.Morada</td>
                                <td>@item.CodPostal</td>
                                <td>@item.Pais</td>
                                <td>@item.Nif</td>
                                <td>@item.Telemovel</td>
                                <td class="text-center">
                                    <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-sm btn-warning me-1" title="Editar">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.ID" class="btn btn-sm btn-info text-white me-1" title="Detalhes">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.ID" class="btn btn-sm btn-danger" title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
