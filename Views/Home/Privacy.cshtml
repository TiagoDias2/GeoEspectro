@{
    ViewData["Title"] = "Privacy Policy";
    // Define o título da página como "Privacy Policy" (Política de Privacidade).
    // Este título pode ser usado na `Layout` ou exibido dinamicamente na view.
}

<h1>@ViewData["Title"]</h1>
<!-- Mostra o título da página (neste caso, "Privacy Policy") como um cabeçalho H1. -->

<p>Use this page to detail your site's privacy policy.</p>
<!-- Parágrafo com uma mensagem informativa.
     Neste caso, um texto genérico sugerindo que esta página deve ser usada
     para descrever a política de privacidade do site. -->
