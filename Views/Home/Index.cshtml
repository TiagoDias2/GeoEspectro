@{
    ViewData["Title"] = "GeoEspectro";
}

<div class="container text-center mt-5">
    <h1 class="display-3 mb-4">GeoEspectro</h1>

    <form method="get" action="/Home/Index" class="d-flex justify-content-center mb-5">
        <input name="q" class="form-control w-50" type="search" placeholder="Pesquisar..." aria-label="Pesquisar">
        <button class="btn btn-primary ms-2" type="submit">Pesquisar</button>
    </form>

    <div class="d-flex justify-content-center mb-5">
        <select class="form-select w-25" onchange="location = this.value;">
            <option value="/Home">Filtrar por Categoria</option>
            <option value="/Home/Index?categoria=Geologia">Geologia</option>
            <option value="/Home/Index?categoria=Dinossauros">Dinossauros</option>
            <option value="/Home/Index?categoria=Descobrimentos">Descobrimentos</option>
            <option value="/Home/Index?categoria=Fosseis">Fósseis</option>
            <option value="/Home/Index?categoria=Plantas">Plantas</option>
        </select>
    </div>

    <div class="container mt-5">
        <h2 class="mb-4 text-center">Notícias</h2>
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @* Exemplo de notícia – idealmente este bloco seria repetido dinamicamente *@
            <div class="col">
                <div class="card h-100">
                    <img src="/images/dinossauro.jpg" class="card-img-top" alt="Imagem da notícia">
                    <div class="card-body">
                        <h5 class="card-title">Descoberta de Fóssil</h5>
                        <p class="card-text">Pesquisadores encontraram um novo fóssil de dinossauro na região sul...</p>
                        <a href="/Noticia/1" class="btn btn-primary">Ler mais</a>
                    </div>
                </div>
            </div>

            <div class="col">
                <div class="card h-100">
                    <img src="/images/planta.jpg" class="card-img-top" alt="Imagem da notícia">
                    <div class="card-body">
                        <h5 class="card-title">Nova Espécie de Planta</h5>
                        <p class="card-text">Uma espécie pré-histórica de planta foi identificada em fósseis milenares...</p>
                        <a href="/Noticia/2" class="btn btn-primary">Ler mais</a>
                    </div>
                </div>
            </div>

            @* Adicione mais blocos conforme necessário ou use um loop Razor *@
        </div>
    </div>z

</div>