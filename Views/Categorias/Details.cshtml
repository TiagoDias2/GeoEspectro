@model GeoEspectro.Models.Categorias

@{
    ViewData["Title"] = "Detalhes da Categoria";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <h4 class="card-title text-primary">@Model.Categoria</h4>
        <dl class="row mt-4">
            <dt class="col-sm-3 text-muted">
                Nome da Categoria
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Categoria)
            </dd>
        </dl>
    </div>
</div>

<div class="mt-4">
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning me-2">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Voltar à Lista</a>
</div>
