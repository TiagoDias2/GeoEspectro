<!DOCTYPE html>
<!-- Declaração do tipo de documento HTML5 -->
<html lang="en">
<!-- Idioma base da página (inglês) -->

<head>
    <!-- Meta tags essenciais -->
    <meta charset="utf-8" /> <!-- Codificação de caracteres UTF-8 -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0" /> <!-- Configuração para responsividade -->
    <!-- Título dinâmico da página -->
    <title>@ViewData["Title"] - GeoEspectro</title>

    <!-- Framework Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Ícones Bootstrap via CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />

    <!-- Folhas de estilo personalizadas -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /> <!-- Cache-busting com versionamento -->
    <link rel="stylesheet" href="~/GeoEspectro.styles.css" asp-append-version="true" /> <!-- Estilos específicos do projeto -->
</head>

<!-- Corpo da página com fundo claro -->
<body class="bg-light">
    <header>
        <!-- Barra de navegação principal -->
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
            <div class="container-fluid">
                <!-- Logo/Marca da aplicação -->
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-globe2 me-1"></i> GeoEspectro
                </a>

                <!-- Botão para menu mobile -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarGeo"
                        aria-controls="navbarGeo" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Itens do menu -->
                <div class="collapse navbar-collapse" id="navbarGeo">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 fw-semibold">
                        <!-- Item Home -->
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door"></i> Home
                            </a>
                        </li>

                        <!-- Item Artigos -->
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Artigos" asp-action="Index">
                                <i class="bi bi-journal-text"></i> Artigos
                            </a>
                        </li>

                        <!-- Item Categorias -->
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Categorias" asp-action="Index">
                                <i class="bi bi-tags"></i> Categorias
                            </a>
                        </li>

                        <!-- Item Recursos -->
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Recursos" asp-action="Index">
                                <i class="bi bi-folder2-open"></i> Recursos
                            </a>
                        </li>

                        <!-- Item Utilizadores (apenas para Admin) -->
                        @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Utilizadores" asp-action="Index">
                                    <i class="bi bi-people"></i> Utilizadores
                                </a>
                            </li>
                        }
                    </ul>

                    <!-- Partial View para login/logout -->
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <!-- Conteúdo principal da página -->
    <div class="container my-4">
        <main role="main" class="bg-white shadow-sm rounded p-4">
            @RenderBody() <!-- Local onde o conteúdo específico de cada página será renderizado -->
        </main>
    </div>

    <!-- Rodapé da página -->
    <footer class="bg-dark text-light py-3 mt-5">
        <div class="container text-center small">
            &copy; 2025 - GeoEspectro |
            <a class="text-decoration-none text-light" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <!-- Scripts JavaScript -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script> <!-- Biblioteca jQuery -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script> <!-- Bootstrap JS (com Popper) -->
    <script src="~/js/site.js" asp-append-version="true"></script> <!-- Scripts personalizados -->
    <!-- Seção para scripts específicos de cada página -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
