@model GeoEspectro.Models.Recursos
@* Define que esta View utiliza um modelo do tipo "Recursos" da aplicação *@

@{
    ViewData["Title"] = "Criar Recurso";
    @* Define o título da página que será usado no layout e apresentado no topo *@
}

<h1 class="mb-4 fw-bold">@ViewData["Title"]</h1>
@* Mostra o título da página com algum espaçamento inferior e texto em negrito *@

<div class="row">
    <div class="col-md-6">
        @* Cria uma secção de formulário com largura média de 6 colunas (em 12) *@

        <form asp-action="Create" method="post" enctype="multipart/form-data">
            @* Início do formulário que envia dados para o método "Create" no controller, com suporte para upload de ficheiros *@

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            @* Mostra mensagens de validação globais para o modelo, se existirem *@

            <div class="mb-3">
                <label asp-for="Nome" class="form-label"></label>
                @* Rótulo associado ao campo "Nome" do modelo *@

                <input asp-for="Nome" class="form-control" />
                @* Campo de input para o nome do recurso *@

                <span asp-validation-for="Nome" class="text-danger"></span>
                @* Mostra mensagem de erro, se o campo "Nome" for inválido *@
            </div>

            <div class="mb-3">
                <label asp-for="Local" class="form-label"></label>
                @* Rótulo associado ao campo "Local" do modelo *@

                <input asp-for="Local" class="form-control" />
                @* Campo de input para o local do recurso *@

                <span asp-validation-for="Local" class="text-danger"></span>
                @* Mostra mensagem de erro de validação para "Local" *@
            </div>

            <div class="mb-3">
                <label asp-for="Ficheiro" class="form-label">Ficheiro (imagem ou vídeo)</label>
                @* Rótulo associado ao campo "Ficheiro", com descrição adicional *@

                <input type="file" accept=".png,.jpeg,.mp4,.ogg,.webm" name="imagemFoto" class="form-control" />
                @* Campo de seleção de ficheiro, apenas permite certos tipos (imagem ou vídeo) *@

                <span asp-validation-for="Ficheiro" class="text-danger"></span>
                @* Mostra mensagem de erro, se o ficheiro for inválido *@
            </div>

            <div class="mb-3">
                <label asp-for="Observacao" class="form-label"></label>
                @* Rótulo associado ao campo "Observacao" do modelo *@

                <input asp-for="Observacao" class="form-control" />
                @* Campo de input para observações adicionais *@

                <span asp-validation-for="Observacao" class="text-danger"></span>
                @* Mostra mensagem de erro, se o campo "Observacao" não for válido *@
            </div>

            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-secondary">← Voltar à Lista</a>
                @* Botão que redireciona o utilizador de volta à lista de recursos *@

                <input type="submit" value="Criar Recurso" class="btn btn-primary" />
                @* Botão para submeter o formulário e criar o novo recurso *@
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    @* Inclui os scripts necessários para validação no lado do cliente *@
}

