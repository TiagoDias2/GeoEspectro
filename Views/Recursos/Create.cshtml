@model GeoEspectro.Models.Recursos

@{
    ViewData["Title"] = "Criar Recurso";
}

<h1 class="mb-4 fw-bold">@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Nome" class="form-label"></label>
                <input asp-for="Nome" class="form-control" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Local" class="form-label"></label>
                <input asp-for="Local" class="form-control" />
                <span asp-validation-for="Local" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Ficheiro" class="form-label">Ficheiro (imagem ou vídeo)</label>
                <input type="file" accept=".png,.jpeg,.mp4,.ogg,.webm" name="imagemFoto" class="form-control" />
                <span asp-validation-for="Ficheiro" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Observacao" class="form-label"></label>
                <input asp-for="Observacao" class="form-control" />
                <span asp-validation-for="Observacao" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-secondary">← Voltar à Lista</a>
                <input type="submit" value="Criar Recurso" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
