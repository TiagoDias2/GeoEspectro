@model GeoEspectro.Models.Recursos

@{
    ViewData["Title"] = "Detalhes do Recurso";
    var ficheiro = Model.Ficheiro ?? "";
    var extensao = System.IO.Path.GetExtension(ficheiro).ToLowerInvariant();
    var isVideo = extensao == ".mp4" || extensao == ".webm" || extensao == ".ogg";
    var caminho = Url.Content(isVideo ? $"~/videos/{ficheiro}" : $"~/imagens/{ficheiro}");
}

<link href="https://vjs.zencdn.net/8.10.0/video-js.css" rel="stylesheet" />
<script src="https://vjs.zencdn.net/8.10.0/video.min.js"></script>

<h1 class="mb-4 text-primary fw-bold">@ViewData["Title"]</h1>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-light fw-semibold">
        Informação do Recurso
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Nome</dt>
            <dd class="col-sm-9">@Model.Nome</dd>

            <dt class="col-sm-3">Data</dt>
            <dd class="col-sm-9">@Model.Data.ToString("dd/MM/yyyy HH:mm")</dd>

            <dt class="col-sm-3">Tipo</dt>
            <dd class="col-sm-9">@Model.Tipo</dd>

            <dt class="col-sm-3">Local</dt>
            <dd class="col-sm-9">@Model.Local</dd>

            <dt class="col-sm-3">Observação</dt>
            <dd class="col-sm-9">@Model.Observacao</dd>

            <dt class="col-sm-3">Autor</dt>
            <dd class="col-sm-9">@Model.Autor?.Nome</dd>
        </dl>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Ficheiro))
{
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-light fw-semibold">Visualização</div>
        <div class="card-body">
            @if (isVideo)
            {
                <div class="ratio ratio-16x9">
                    <video id="meuVideo"
                           class="video-js vjs-default-skin"
                           controls
                           preload="auto"
                           data-setup='{"fluid": true, "aspectRatio": "16:9"}'>
                        <source src="@caminho" type="video/@extensao.TrimStart('.')">
                        O seu navegador não suporta a reprodução de vídeo.
                    </video>
                </div>
            }
            else
            {
                <div class="text-center">
                    <img src="@caminho" alt="Imagem" class="img-fluid rounded border" style="max-height: 500px;" />
                </div>
            }
        </div>
    </div>
}

<div class="d-flex gap-2">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Voltar à Lista</a>
</div>
