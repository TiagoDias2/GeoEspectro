@model GeoEspectro.Models.Recursos
<!-- Define o modelo utilizado na view, que neste caso é uma instância de "Recursos" -->
@{
    ViewData["Title"] = "Detalhes do Recurso";
    <!-- Define o título da página -->
    var ficheiro = Model.Ficheiro ?? "";
    <!-- Guarda o nome do ficheiro ou uma string vazia caso seja nulo -->
    var extensao = System.IO.Path.GetExtension(ficheiro).ToLowerInvariant();
    <!-- Extrai a extensão do ficheiro em minúsculas (ex: .mp4, .jpg) -->
    var isVideo = extensao == ".mp4" || extensao == ".webm" || extensao == ".ogg";
    <!-- Verifica se o ficheiro é um vídeo com base na extensão -->
    var caminho = Url.Content(isVideo ? $"~/videos/{ficheiro}" : $"~/imagens/{ficheiro}");
    <!-- Define o caminho correto consoante o tipo de ficheiro (vídeo ou imagem) -->
}

<!-- Importa a folha de estilos do Video.js -->
<link href="https://vjs.zencdn.net/8.10.0/video-js.css" rel="stylesheet" />

<!-- Importa o script do player de vídeo Video.js -->
<script src="https://vjs.zencdn.net/8.10.0/video.min.js"></script>

<h1 class="mb-4 text-primary fw-bold">@ViewData["Title"]</h1>
<!-- Mostra o título da página com estilo -->
<!-- Cartão com os dados do recurso -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-light fw-semibold">
        Informação do Recurso
        <!-- Cabeçalho do cartão -->
    </div>
    <div class="card-body">
        <!-- Corpo do cartão onde se mostram os dados -->

        <dl class="row">
            <!-- Lista de definições com os campos do recurso -->

            <dt class="col-sm-3">Nome</dt>
            <dd class="col-sm-9">@Model.Nome</dd>
            <!-- Nome do recurso -->

            <dt class="col-sm-3">Data</dt>
            <dd class="col-sm-9">@Model.Data.ToString("dd/MM/yyyy HH:mm")</dd>
            <!-- Data formatada do recurso -->

            <dt class="col-sm-3">Tipo</dt>
            <dd class="col-sm-9">@Model.Tipo</dd>
            <!-- Tipo de recurso: imagem ou vídeo -->

            <dt class="col-sm-3">Local</dt>
            <dd class="col-sm-9">@Model.Local</dd>
            <!-- Localização associada ao recurso -->

            <dt class="col-sm-3">Observação</dt>
            <dd class="col-sm-9">@Model.Observacao</dd>
            <!-- Observações feitas sobre o recurso -->

            <dt class="col-sm-3">Autor</dt>
            <dd class="col-sm-9">@Model.Autor?.Nome</dd>
            <!-- Nome do autor (verifica se existe antes de aceder) -->
        </dl>
    </div>
</div>

<!-- Se houver ficheiro, mostra a secção de visualização -->
@if (!string.IsNullOrEmpty(Model.Ficheiro))
{
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-light fw-semibold">Visualização</div>
        <div class="card-body">
            @if (isVideo)
            {
                <!-- Se o ficheiro for um vídeo, mostra o leitor de vídeo -->
                <div class="ratio ratio-16x9">
                    <video id="meuVideo"
                           class="video-js vjs-default-skin"
                           controls
                           preload="auto"
                           data-setup='{"fluid": true, "aspectRatio": "16:9"}'>
                        <source src="@caminho" type="video/@extensao.TrimStart('.')">
                        O seu navegador não suporta a reprodução de vídeo.
                    </video>
                </div>
            }
            else
            {
                <!-- Se não for vídeo, mostra como imagem -->
                <div class="text-center">
                    <img src="@caminho" alt="Imagem" class="img-fluid rounded border" style="max-height: 500px;" />
                </div>
            }
        </div>
    </div>
}

<!-- Botões de ação: Editar e Voltar -->
<div class="d-flex gap-2">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
    <!-- Botão para editar o recurso -->

    <a asp-action="Index" class="btn btn-secondary">Voltar à Lista</a>
    <!-- Botão para voltar à lista de recursos -->
</div>
