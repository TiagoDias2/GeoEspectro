@model GeoEspectro.Models.Recursos

@{
    ViewData["Title"] = "Apagar Recurso";
}

<h1 class="text-danger fw-bold mb-4">@ViewData["Title"]</h1>

<h4 class="mb-3">Tens a certeza que queres apagar este recurso?</h4>

<div class="card border-danger mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Nome</dt>
            <dd class="col-sm-9">@Model.Nome</dd>

            <dt class="col-sm-3">Data</dt>
            <dd class="col-sm-9">@Model.Data.ToString("dd/MM/yyyy HH:mm")</dd>

            <dt class="col-sm-3">Tipo</dt>
            <dd class="col-sm-9">@Model.Tipo</dd>

            <dt class="col-sm-3">Local</dt>
            <dd class="col-sm-9">@Model.Local</dd>

            <dt class="col-sm-3">Ficheiro</dt>
            <dd class="col-sm-9">@Model.Ficheiro</dd>

            <dt class="col-sm-3">Observação</dt>
            <dd class="col-sm-9">@Model.Observacao</dd>

            <dt class="col-sm-3">Autor</dt>
            <dd class="col-sm-9">@Model.Autor?.Nome</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post" class="d-flex gap-2">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Apagar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
