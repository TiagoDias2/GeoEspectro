@model GeoEspectro.Models.Recursos

@{
    ViewData["Title"] = "Editar Recurso";
    var caminho = Model.Tipo == "Imagem" ? "/imagens/" : "/videos/";
}

<h1 class="mb-4 text-primary fw-bold">@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label asp-for="Nome" class="form-label fw-semibold"></label>
                        <input asp-for="Nome" class="form-control" />
                        <span asp-validation-for="Nome" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Local" class="form-label fw-semibold"></label>
                        <input asp-for="Local" class="form-control" />
                        <span asp-validation-for="Local" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Ficheiro Atual</label><br />

                        @if (!string.IsNullOrEmpty(Model.Ficheiro))
                        {
                            if (Model.Tipo == "Imagem")
                            {
                                <img src="@($"{caminho}{Model.Ficheiro}")" alt="Imagem atual" class="img-thumbnail mb-2" style="max-width: 100%; height: auto;" />
                            }
                            else
                            {
                                <video width="100%" height="auto" controls class="mb-2">
                                    <source src="@($"{caminho}{Model.Ficheiro}")" type="video/mp4">
                                    O seu navegador não suporta vídeo.
                                </video>
                            }
                        }
                        else
                        {
                            <p class="text-muted fst-italic">(Nenhum ficheiro disponível)</p>
                        }

                        <label class="form-label mt-2">Substituir Ficheiro</label>
                        <input type="file"
                               accept=".png,.jpeg,.mp4,.ogg,.webm"
                               name="novoFicheiro"
                               class="form-control" />
                        <span asp-validation-for="Ficheiro" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Observacao" class="form-label fw-semibold"></label>
                        <input asp-for="Observacao" class="form-control" />
                        <span asp-validation-for="Observacao" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AutorFK" class="form-label fw-semibold"></label>
                        <select asp-for="AutorFK" class="form-control" asp-items="ViewBag.AutorFK">
                            <option value="0">Escolha um utilizador</option>
                        </select>
                        <span asp-validation-for="AutorFK" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <input type="submit" value="Guardar Alterações" class="btn btn-primary" />
                        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
