@model IEnumerable<GeoEspectro.Models.Recursos>

@{
    ViewData["Title"] = "Index";
}

<h1>Lista de Recursos</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Criar Novo</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.First().Nome)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.First().Data)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.First().Tipo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.First().Local)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.First().Ficheiro)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.First().Observacao)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.First().Autor)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.Nome)</td>
            <td>@Html.DisplayFor(modelItem => item.Data)</td>
            <td>@Html.DisplayFor(modelItem => item.Tipo)</td>
            <td>@Html.DisplayFor(modelItem => item.Local)</td>
            <td>@Html.DisplayFor(modelItem => item.Ficheiro)</td>
            <td>@Html.DisplayFor(modelItem => item.Observacao)</td>
            <td>@Html.DisplayFor(modelItem => item.Autor.Nome)</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Editar</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Detalhes</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Eliminar</a>
            </td>
        </tr>
}
    </tbody>
</table>
