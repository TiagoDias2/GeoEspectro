@model GeoEspectro.Models.Artigos

@{
    ViewData["Title"] = "Detalhes do Artigo";
}

<h1>@Model.Titulo</h1>

<hr />
<dl class="row">
    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.Titulo)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.Titulo)
    </dd>

    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.Texto)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.Texto)
    </dd>

    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.Data)
    </dt>
    <dd class="col-sm-10">
        @Model.Data.ToString("dd/MM/yyyy HH:mm")
    </dd>

    <dt class="col-sm-2">
        Categorias
    </dt>
    <dd class="col-sm-10">
        @if (Model.ListaCategorias != null && Model.ListaCategorias.Any())
        {
            <ul>
                @foreach (var categoria in Model.ListaCategorias)
                {
                    <li>@categoria.Categoria</li>
                }
            </ul>
        }
        else
        {
            <span>(Sem categorias associadas)</span>
        }
    </dd>

    <dt class="col-sm-2">
        Autor
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.Autor.Nome)
    </dd>
</dl>

<hr />
<div>
    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a>
    <a class="btn btn-secondary" asp-action="Index">Voltar à Lista</a>
</div>
