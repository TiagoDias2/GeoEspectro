@model GeoEspectro.Models.Artigos

@{
    ViewData["Title"] = "Detalhes do Artigo";
}

<h1>@Model.Titulo</h1>

<hr />
<dl class="row">
    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.Titulo)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.Titulo)
    </dd>

    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.Texto)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.Texto)
    </dd>

    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.Data)
    </dt>
    <dd class="col-sm-10">
        @Model.Data.ToString("dd/MM/yyyy HH:mm")
    </dd>

    <dt class="col-sm-2">
        Categorias
    </dt>
    <dd class="col-sm-10">
        @if (Model.ListaCategorias != null && Model.ListaCategorias.Any())
        {
            <ul>
                @foreach (var categoria in Model.ListaCategorias)
                {
                    <li>@categoria.Categoria</li>
                }
            </ul>
        }
        else
        {
            <span>(Sem categorias associadas)</span>
        }
    </dd>

    <dt class="col-sm-2">
        Autor
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.Autor.Nome)
    </dd>
</dl>

<hr />

@if (Model.ListaRecursos != null && Model.ListaRecursos.Any())
{
    <h3>Multimédia</h3>
    <div id="carouselRecursos" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">
            @{
                var recursosOrdenados = Model.ListaRecursos
                .OrderByDescending(r => r.Principal) // mostra o principal primeiro
                .ToList();
                int index = 0;

                foreach (var detalhe in recursosOrdenados)
                {
                    var ativo = index == 0 ? "active" : "";
                    var ficheiro = detalhe.Recurso.Ficheiro ?? "";
                    var extensao = System.IO.Path.GetExtension(ficheiro).ToLowerInvariant();
                    var isVideo = extensao == ".mp4" || extensao == ".webm" || extensao == ".ogg";
                    var caminho = isVideo
                    ? Url.Content($"~/videos/{ficheiro}")
                    : Url.Content($"~/imagens/{ficheiro}");

                    <div class="carousel-item @ativo text-center">
                        @if (isVideo)
                        {
                            <video id="meuVideo"
                                   class="video-js vjs-default-skin"
                                   controls
                                   width="100%"
                                   data-setup="{}"
                                   alt="@detalhe.Recurso.Nome">
                                <source src="@caminho" type="video/@extensao.TrimStart('.')">
                                O seu navegador não suporta a reprodução de vídeo.
                            </video>
                        }
                        else
                        {
                            <img src="@caminho" class="d-block mx-auto" style="max-height: 500px;" alt="@detalhe.Recurso.Nome" />
                        }

                        <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-50 rounded">
                            <h5>@detalhe.Recurso.Nome</h5>
                            <p>@detalhe.Recurso.Observacao</p>
                        </div>
                    </div>

                    index++;
                }
            }
        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#carouselRecursos" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Anterior</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#carouselRecursos" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Seguinte</span>
        </button>
    </div>
}
else
{
    <p>(Sem recursos associados)</p>
}

<div>
    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a>
    <a class="btn btn-secondary" asp-action="Index">Voltar à Lista</a>
</div>
