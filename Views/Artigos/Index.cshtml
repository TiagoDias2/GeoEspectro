@model GeoEspectro.Models.ViewModels.ArtigosIndexDTO

@{
    ViewData["Title"] = "Lista de Artigos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">@ViewData["Title"]</h2>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Criar Novo Artigo
        </a>
    </div>

    <form asp-action="Index" method="get" class="mb-4">
        <div class="row g-3">
            <div class="col-md-4">
                <input type="text" name="searchString" value="@Model.SearchString"
                       class="form-control" placeholder="Pesquisar por título..." />
            </div>
            <div class="col-md-4">
                <select name="categoriaId" class="form-select">
                    <option value="">Todas as categorias</option>
                    @foreach (var cat in Model.Categorias)
                    {
                        <option value="@cat.Value" selected="@(Model.CategoriaId == cat.Value ? "selected" : null)">
                            @cat.Text
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-4 d-grid">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-funnel"></i> Filtrar
                </button>
            </div>
        </div>
    </form>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover table-bordered mb-0">
                <thead class="table-light">
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.Artigos.First().Titulo)</th>
                        <th>@Html.DisplayNameFor(model => model.Artigos.First().Texto)</th>
                        <th>@Html.DisplayNameFor(model => model.Artigos.First().Data)</th>
                        <th>Categorias</th>
                        <th>Autor</th>
                        <th class="text-center">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Artigos)
                    {
                        <tr>
                            <td>@item.Titulo</td>
                            <td>@item.Texto?.Substring(0, Math.Min(item.Texto.Length, 60))...</td>
                            <td>@item.Data.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                @if (item.ListaCategorias?.Any() == true)
                                {
                                    <ul class="list-unstyled mb-0">
                                        @foreach (var cat in item.ListaCategorias)
                                        {
                                            <li><span class="badge bg-secondary">@cat.Categoria.Categoria</span></li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <span class="text-muted">(Sem categorias)</span>
                                }
                            </td>
                            <td>@item.Autor?.Nome</td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning me-1" title="Editar">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info me-1 text-white" title="Detalhes">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" title="Apagar">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
