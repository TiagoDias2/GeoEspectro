@model GeoEspectro.Models.ViewModels.ArtigoDTO

@{
    ViewData["Title"] = "Criar Artigo";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div class="mb-3">
                <label asp-for="Titulo" class="form-label fw-bold">Título</label>
                <input asp-for="Titulo" class="form-control" />
                <span asp-validation-for="Titulo" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Texto" class="form-label fw-bold">Texto</label>
                <textarea asp-for="Texto" rows="6" class="form-control"></textarea>
                <span asp-validation-for="Texto" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ListaCategoriasSelecionadas" class="form-label fw-bold">Categorias</label>
                <select asp-for="ListaCategoriasSelecionadas" asp-items="Model.ListaCategorias" class="form-select" multiple>
                </select>
                <span asp-validation-for="ListaCategoriasSelecionadas" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ListaRecursosSelecionados" class="form-label fw-bold">Recursos Multimédia</label>
                <select asp-for="ListaRecursosSelecionados" asp-items="Model.ListaRecursos" class="form-select" multiple></select>
            </div>

            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-secondary">← Voltar à Lista</a>
                <button type="submit" class="btn btn-primary">Criar Artigo</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
