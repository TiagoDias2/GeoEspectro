@model GeoEspectro.Models.ViewModels.ArtigoDTO

@{
    ViewData["Title"] = "Criar Artigo";
}

<h1>Criar um Novo Artigo</h1>

<h4>Artigos</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" method="post">
            <div class="form-group">
                <label asp-for="Titulo"></label>
                <input asp-for="Titulo" class="form-control" />
                <span asp-validation-for="Titulo" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Texto"></label>
                <textarea asp-for="Texto" class="form-control"></textarea>
                <span asp-validation-for="Texto" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="UtilizadorFK"></label>
                <select asp-for="UtilizadorFK" asp-items="Model.ListaUtilizadores" class="form-control">
                    <option value="">-- Selecione um utilizador --</option>
                </select>
                <span asp-validation-for="UtilizadorFK" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ListaCategoriasSelecionadas"></label>
                <select asp-for="ListaCategoriasSelecionadas" asp-items="Model.ListaCategorias" class="form-control" multiple>
                </select>
                <span asp-validation-for="ListaCategoriasSelecionadas" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Criar Artigo</button>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Voltar à Lista de Artigos</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
