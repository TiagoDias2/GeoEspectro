@model GeoEspectro.Models.ViewModels.ArtigoDTO
@{
    ViewData["Title"] = "Editar Artigo";
}

<h1 class="mb-4 fw-bold">@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" method="post" class="needs-validation" novalidate>
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Titulo" class="form-label fw-bold"></label>
                <input asp-for="Titulo" class="form-control" />
                <span asp-validation-for="Titulo" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Texto" class="form-label fw-bold"></label>
                <textarea asp-for="Texto" class="form-control" rows="5"></textarea>
                <span asp-validation-for="Texto" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="UtilizadorFK" class="form-label fw-bold">Autor</label>
                <select asp-for="UtilizadorFK" class="form-select" asp-items="Model.ListaUtilizadores">
                    <option value="">-- Selecione o Utilizador --</option>
                </select>
                <span asp-validation-for="UtilizadorFK" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ListaCategoriasSelecionadas" class="form-label fw-bold">Categorias</label>
                <select asp-for="ListaCategoriasSelecionadas" class="form-select" asp-items="Model.ListaCategorias" multiple></select>
                <span asp-validation-for="ListaCategoriasSelecionadas" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ListaRecursosSelecionados" class="form-label fw-bold">Recursos Multimédia</label>
                <select asp-for="ListaRecursosSelecionados" class="form-select" asp-items="Model.ListaRecursos" multiple></select>
                <span asp-validation-for="ListaRecursosSelecionados" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-between mt-3">
                <a asp-action="Index" class="btn btn-secondary">← Cancelar</a>
                <button type="submit" class="btn btn-primary">Guardar Alterações</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
