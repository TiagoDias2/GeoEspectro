@model GeoEspectro.Models.ViewModels.ArtigoDTO
@{
    ViewData["Title"] = "Editar Artigo";
}

<h1>Editar Artigo</h1>

<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="form-group">
                <label asp-for="Titulo" class="control-label"></label>
                <input asp-for="Titulo" class="form-control" />
                <span asp-validation-for="Titulo" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Texto" class="control-label"></label>
                <textarea asp-for="Texto" class="form-control"></textarea>
                <span asp-validation-for="Texto" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="UtilizadorFK" class="control-label"></label>
                <select asp-for="UtilizadorFK" class="form-control" asp-items="Model.ListaUtilizadores">
                    <option value="">-- Selecione o Utilizador --</option>
                </select>
                <span asp-validation-for="UtilizadorFK" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ListaCategoriasSelecionadas" class="control-label">Categorias</label>
                <select asp-for="ListaCategoriasSelecionadas" class="form-control" asp-items="Model.ListaCategorias" multiple>
                </select>
                <span asp-validation-for="ListaCategoriasSelecionadas" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ListaRecursosSelecionados" class="control-label">Recursos</label>
                <select asp-for="ListaRecursosSelecionados" class="form-control" asp-items="Model.ListaRecursos" multiple>
                </select>
                <span asp-validation-for="ListaRecursosSelecionados" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Guardar" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Voltar à Lista</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
